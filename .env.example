# Database Configuration (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:5432/DATABASE_NAME
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE_NAME"

# Authentication (Minimum 32 characters)
AUTH_SECRET="your-super-secret-auth-key-at-least-32-chars-long"

# Application URL
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional: Seed Admin Password (Minimum 12 characters, used for `npm run db:seed`)
SEED_ADMIN_PASSWORD="YourSecureAdminPassword123!"

# Optional: Vercel Blob Storage Token (for production uploads)
# BLOB_READ_WRITE_TOKEN=""

# Optional: Email Service
# EMAIL_API_KEY=""

